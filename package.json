{
  "name": "@react-hive/honey-layout",
  "version": "18.7.0",
  "description": "React layout components with responsive, theme-aware style props (Box, Flex, Grid, List), plus popups, context menus and overlay management.",
  "keywords": [
    "react",
    "layout",
    "components",
    "flexbox",
    "grid",
    "responsive",
    "breakpoints",
    "theme",
    "css-in-js",
    "style-props",
    "popup",
    "context-menu",
    "overlay",
    "floating-ui",
    "typescript",
    "react-hive",
    "honey-style"
  ],
  "homepage": "https://react-honey-layout.netlify.app",
  "bugs": {
    "url": "https://github.com/React-Hive/honey-layout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/React-Hive/honey-layout.git"
  },
  "author": "Mike Aliinyk <m.aliynik@gmail.com>",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist coverage",
    "start": "NODE_ENV=development webpack serve --config webpack-docs.config.mjs",
    "test": "vitest",
    "build:lib": "webpack --config webpack.config.mjs",
    "build:docs": "webpack --config webpack-docs.config.mjs",
    "prepublishOnly": "CI=1 pnpm clean && pnpm test && pnpm build:lib",
    "diagnostics": "tsx scripts/collect-diagnostics.ts"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.dev.cjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/__mocks__",
    "!dist/**/__tests__"
  ],
  "peerDependencies": {
    "@react-hive/honey-css": "^1.20.0",
    "@react-hive/honey-style": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@floating-ui/react": "0.27.20",
    "@react-hive/honey-hooks": "3.1.0",
    "@react-hive/honey-utils": "4.2.0",
    "csstype": "3.2.3",
    "highlight.js": "11.12.0",
    "lodash.merge": "4.6.2",
    "lodash.throttle": "4.1.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash.merge": "4.6.9",
    "@types/lodash.throttle": "4.1.9",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "10.12.0",
    "eslint-plugin-react": "7.37.5",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ]
}
